# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "3cmt-oral-lag"
ode = true
error = "combined"

[groups]
names = ["A", "B", "C", "D", "E", "F"]
doses = [10, 20, 40, 80, 160, 320]
subjects = [15, 15, 15, 15, 15, 15]

[regimen]
n_doses = 7
interval = 24
infusion_duration = 1

[sampling]
times = [0.5, 1, 2, 3, 4, 6, 8, 12, 24]
sparse = 6
lloq = 0.02

[parameters]
CL = 3.2
V = 42
Q = 5
VP = 80
Q2 = 1.5
VP2 = 120
KA = 1.1
ALAG = 0.5

[variability]
iiv = { CL = 30, KA = 40, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~AGE" = -0.2, "CL~EGFR" = 0.6, "CL~SEX" = 0.85, "CL~WT" = 0.75, "V~WT" = 1 }
covariate_model = true

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261100
fit = true
gof_plots = true
author = "Sofia Ndlovu"
