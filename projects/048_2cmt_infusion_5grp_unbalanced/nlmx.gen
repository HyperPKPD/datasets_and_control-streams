# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "2cmt-infusion"
ode = false
error = "combined"

[groups]
names = ["Group 1", "Group 2", "Group 3", "Group 4", "Group 5"]
doses = [50, 100, 200, 400, 800]
subjects = [10, 10, 20, 30, 40]

[regimen]
n_doses = 1
interval = 24
infusion_duration = 1

[sampling]
times = [0.5, 1, 1.25, 1.5, 2, 4, 8, 12, 24, 48, 72]
sparse = 0
lloq = 0

[parameters]
CL = 3.2
V = 42
Q = 5
VP = 80

[variability]
iiv = { CL = 30, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~EGFR" = 0.6, "CL~WT" = 0.75, "V~WT" = 1 }
covariate_model = false

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261048
fit = true
gof_plots = true
author = "Astrid Patel"
