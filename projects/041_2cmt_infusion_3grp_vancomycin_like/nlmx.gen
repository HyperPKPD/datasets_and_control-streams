# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "2cmt-infusion"
ode = false
error = "combined"

[groups]
names = ["Group 1", "Group 2", "Group 3"]
doses = [750, 1000, 1500]
subjects = [34, 33, 33]

[regimen]
n_doses = 8
interval = 12
infusion_duration = 1

[sampling]
times = [0.5, 1, 2, 4, 6, 8, 12]
sparse = 0
lloq = 0

[parameters]
CL = 4
V = 30
Q = 6
VP = 40

[variability]
iiv = { CL = 30, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~CRCL" = 0.75, "V~WT" = 1 }
covariate_model = false

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261041
fit = true
gof_plots = true
author = "Erik Nilsen"
