# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "2cmt-oral"
ode = false
error = "combined"

[groups]
names = ["Group 1", "Group 2"]
doses = [100, 200]
subjects = [50, 50]

[regimen]
n_doses = 1
interval = 24
infusion_duration = 1

[sampling]
times = [0.5, 1, 2, 3, 4, 6, 8, 12, 24, 48, 72]
sparse = 0
lloq = 0

[parameters]
CL = 3.2
V = 42
Q = 5
VP = 80
KA = 1.1

[variability]
iiv = { CL = 50, V = 40 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = {  }
covariate_model = false

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261050
fit = true
gof_plots = true
author = "Felix Ferreira"
