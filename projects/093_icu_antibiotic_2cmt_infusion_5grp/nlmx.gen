# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "2cmt-infusion"
ode = false
error = "combined"

[groups]
names = ["Group 1", "Group 2", "Group 3", "Group 4", "Group 5"]
doses = [500, 750, 1000, 1500, 2000]
subjects = [20, 20, 20, 20, 20]

[regimen]
n_doses = 9
interval = 8
infusion_duration = 0.5

[sampling]
times = [0.5, 1, 2, 4, 6, 8]
sparse = 4
lloq = 0.5

[parameters]
CL = 6
V = 20
Q = 8
VP = 25

[variability]
iiv = { CL = 30, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~CRCL" = 0.85, "V~WT" = 1 }
covariate_model = true

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261093
fit = true
gof_plots = true
author = "Astrid Whitfield"
