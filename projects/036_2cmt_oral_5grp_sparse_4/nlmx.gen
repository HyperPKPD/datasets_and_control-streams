# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "2cmt-oral"
ode = false
error = "combined"

[groups]
names = ["Group 1", "Group 2", "Group 3", "Group 4", "Group 5"]
doses = [20, 40, 80, 160, 320]
subjects = [30, 30, 30, 30, 30]

[regimen]
n_doses = 1
interval = 24
infusion_duration = 1

[sampling]
times = [0.5, 1, 2, 3, 4, 6, 8, 12, 24, 48, 72]
sparse = 4
lloq = 0

[parameters]
CL = 3.2
V = 42
Q = 5
VP = 80
KA = 1.1

[variability]
iiv = { CL = 30, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~EGFR" = 0.6, "CL~WT" = 0.75, "V~WT" = 1 }
covariate_model = false

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261036
fit = true
gof_plots = true
author = "Linnea MacLeod"
