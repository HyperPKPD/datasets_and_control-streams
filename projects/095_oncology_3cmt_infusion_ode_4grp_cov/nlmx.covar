# nlmx covariate analysis of the generated project (TOML syntax).
# Truth: CL~AGE exponent -0.2, CL~WT exponent 0.75, V~WT exponent 1; CRCL is a near-copy of EGFR.
# Settings not written here keep their defaults (`nlmx schema`).

method = "frozen"            # frozen | posterior | both (or --method)

[input]
model_dir = "models"
run_stem  = "run101"

[output]
directory = "out"

# covariates to test per parameter; types and equations are worked out
[covariates]
CL = ["WT", "AGE", "SEX", "EGFR", "CRCL"]
V = ["WT", "AGE", "SEX"]
