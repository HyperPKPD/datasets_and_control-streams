# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "3cmt-infusion"
ode = true
error = "combined"

[groups]
names = ["Group 1", "Group 2", "Group 3", "Group 4"]
doses = [100, 150, 200, 250]
subjects = [25, 25, 25, 25]

[regimen]
n_doses = 3
interval = 504
infusion_duration = 1

[sampling]
times = [0.5, 1, 2, 4, 8, 24, 72, 168, 504]
sparse = 0
lloq = 0

[parameters]
CL = 3.2
V = 42
Q = 5
VP = 80
Q2 = 1.5
VP2 = 120

[variability]
iiv = { CL = 30, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~AGE" = -0.2, "CL~WT" = 0.75, "V~WT" = 1 }
covariate_model = true

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261095
fit = true
gof_plots = true
author = "Tobias Cohen"
