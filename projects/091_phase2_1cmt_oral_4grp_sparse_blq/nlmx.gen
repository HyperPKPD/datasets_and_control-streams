# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "1cmt-oral"
ode = false
error = "combined"

[groups]
names = ["D25", "D50", "D100", "D200"]
doses = [25, 50, 100, 200]
subjects = [50, 50, 50, 50]

[regimen]
n_doses = 1
interval = 24
infusion_duration = 1

[sampling]
times = [0.5, 1, 2, 3, 4, 6, 8, 12, 24]
sparse = 3
lloq = 0.05

[parameters]
CL = 3.2
V = 42
KA = 1.1

[variability]
iiv = { CL = 30, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~EGFR" = 0.5, "CL~WT" = 0.75, "V~WT" = 1 }
covariate_model = false

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261091
fit = true
gof_plots = true
author = "Sebastian Bakari"
