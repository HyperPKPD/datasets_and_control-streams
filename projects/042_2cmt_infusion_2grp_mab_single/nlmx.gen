# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "2cmt-infusion"
ode = false
error = "combined"

[groups]
names = ["Group 1", "Group 2"]
doses = [200, 400]
subjects = [50, 50]

[regimen]
n_doses = 1
interval = 24
infusion_duration = 2

[sampling]
times = [1, 2, 6, 24, 72, 168, 336, 504, 672, 1008, 1344]
sparse = 0
lloq = 0

[parameters]
CL = 0.01
V = 3
Q = 0.02
VP = 2.5

[variability]
iiv = { CL = 35, V = 20 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~EGFR" = 0.6, "CL~WT" = 0.75, "V~WT" = 1 }
covariate_model = false

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261042
fit = true
gof_plots = true
author = "Ngozi Reddy"
