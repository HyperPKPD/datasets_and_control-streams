# nlmx generate settings actually used. Repeat with:
#   nlmx generate -c nlmx.gen --output <folder>

[design]
structure = "1cmt-iv"
ode = false
error = "combined"

[groups]
names = ["Group 1", "Group 2", "Group 3", "Group 4", "Group 5", "Group 6"]
doses = [5, 10, 20, 40, 80, 160]
subjects = [20, 20, 20, 20, 20, 20]

[regimen]
n_doses = 1
interval = 24
infusion_duration = 1

[sampling]
times = [0.083, 0.25, 0.5, 1, 2, 4, 8, 12, 24]
sparse = 4
lloq = 0.05

[parameters]
CL = 3.2
V = 42

[variability]
iiv = { CL = 30, V = 25 }
proportional_error = 15
additive_error = 0.02

[covariates]
effects = { "CL~EGFR" = 0.6, "CL~WT" = 0.75, "V~WT" = 1 }
covariate_model = false

[population]
wt_median = 70
wt_cv = 25
age_mean = 45
age_sd = 15
p_sex = 0.5
egfr_median = 95
egfr_cv = 30
crcl_noise = 5

[output]
seed = 20261026
fit = true
gof_plots = true
author = "Lina Johansson"
